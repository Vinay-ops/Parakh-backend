# --- Supabase (REQUIRED) ---------------------------------------------------
# Project URL, anon key, and service-role key from
# Supabase Dashboard -> Settings -> API.
# The service-role key must exist ONLY on the backend. Never expose it to Flutter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (REQUIRED) ----------------------------------------------------
# Supabase PostgreSQL connection string (backend-only). Use the pooler settings
# from Supabase Dashboard -> Database -> Connection string if desired.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Optional ----------------------------------------------------------------
# Comma-separated exact origins allowed for browser clients. Mobile Flutter
# clients do not need CORS; leave empty for mobile-only deployments.
ALLOWED_ORIGINS=

# Maximum upload size for scan images (default 10 MB).
MAX_IMAGE_SIZE_MB=10

# Supabase Storage bucket for product images (must exist; public-read recommended).
SUPABASE_STORAGE_BUCKET=product-images
